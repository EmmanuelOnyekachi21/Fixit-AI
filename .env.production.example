# Production Environment Variables Template
# Copy this to Render's environment variables dashboard

# Django Settings
SECRET_KEY=<generate-new-secret-key-in-render>
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings_production

# Custom Domain (optional)
# CUSTOM_DOMAIN=yourdomain.com

# Vercel Frontend URL (add after deploying frontend)
# VERCEL_URL=your-app.vercel.app

# API Keys (REQUIRED - Add these in Render dashboard)
GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_BOT_TOKEN=your_github_token_here

# Database (Auto-configured by Render)
# DATABASE_URL=postgresql://...

# Redis (Auto-configured by Render)
# REDIS_URL=redis://...
